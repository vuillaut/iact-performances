{
  "$defs": {
    "CrabSpectrum": {
      "additionalProperties": false,
      "description": "A reference Crab spectrum, used to interpret values given in Crab units.\n\nModels (E0 = ``reference_energy``, A = ``amplitude``):\n\n- ``power_law``: A (E/E0)^-index\n- ``log_parabola_log10``: A (E/E0)^(-index - curvature log10(E/E0))\n- ``log_parabola_ln``: A (E/E0)^(-index - curvature ln(E/E0))",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "reference": {
          "description": "DOI or URL of the publication of the fit",
          "title": "Reference",
          "type": "string"
        },
        "model": {
          "enum": [
            "power_law",
            "log_parabola_log10",
            "log_parabola_ln"
          ],
          "title": "Model",
          "type": "string"
        },
        "amplitude": {
          "title": "Amplitude",
          "type": "string"
        },
        "reference_energy": {
          "title": "Reference Energy",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "number"
        },
        "curvature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curvature"
        },
        "energy_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Energy Range"
        }
      },
      "required": [
        "id",
        "description",
        "reference",
        "model",
        "amplitude",
        "reference_energy",
        "index"
      ],
      "title": "CrabSpectrum",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content of ``references/crab_spectra.yaml``.",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "spectra": {
      "items": {
        "$ref": "#/$defs/CrabSpectrum"
      },
      "title": "Spectra",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "spectra"
  ],
  "title": "CrabSpectra",
  "type": "object"
}
